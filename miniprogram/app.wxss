page {
  background: #0a0a0f;
  color: #e0e0e0;
  font-family: -apple-system, 'PingFang SC', 'Noto Sans SC', sans-serif;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.title {
  font-size: 72rpx;
  font-weight: 900;
  color: #fff;
  text-align: center;
  margin-bottom: 16rpx;
}

.subtitle {
  color: #888;
  font-size: 28rpx;
  letter-spacing: 6rpx;
  margin-bottom: 80rpx;
}

.genre-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
  width: 100%;
}

.genre-btn {
  width: 200rpx;
  height: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.05);
  border: 2rpx solid rgba(255,255,255,0.1);
  border-radius: 20rpx;
  color: #ccc;
  font-size: 28rpx;
  transition: all 0.3s;
}

.genre-btn.active {
  background: rgba(108,92,231,0.2);
  border-color: rgba(108,92,231,0.6);
  color: #fff;
  box-shadow: 0 0 30rpx rgba(108,92,231,0.2);
}

.genre-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.custom-input {
  width: 100%;
  padding: 24rpx;
  background: rgba(255,255,255,0.05);
  border: 2rpx solid rgba(255,255,255,0.15);
  border-radius: 16rpx;
  color: #fff;
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.start-btn {
  background: linear-gradient(135deg, #6c5ce7, #a855f7);
  color: #fff;
  padding: 28rpx 100rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.start-btn.disabled {
  opacity: 0.4;
}
